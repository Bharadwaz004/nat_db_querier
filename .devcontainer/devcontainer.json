{
  "name": "NL-SQL",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },
  "forwardPorts": [5173, 3001, 8000],
  "portsAttributes": {
    "5173": { "label": "Frontend", "onAutoForward": "openBrowser" },
    "3001": { "label": "Node Gateway" },
    "8000": { "label": "FastAPI" }
  },
  "postCreateCommand": "bash .devcontainer/install.sh",
  "postStartCommand": "bash .devcontainer/startup.sh",
  "remoteEnv": {
    "PYTHONPATH": "/workspaces/${localWorkspaceFolderBasename}"
  }
}
