# ─── LLM Provider ─────────────────────────────────────────────
# Options: "anthropic" or "huggingface"
LLM_PROVIDER=huggingface

# Anthropic (recommended — works out of the box)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# HuggingFace (alternative)
HF_API_KEY=
HF_API_URL=https://router.huggingface.co/v1
HF_MODEL=meta-llama/Llama-3.3-70B-Instruct

# ─── Server Ports ─────────────────────────────────────────────
FASTAPI_PORT=8000
NODE_PORT=3001
VITE_PORT=5173

# ─── JWT Secret (shared between Node.js and FastAPI) ──────────
JWT_SECRET=nlsql-super-secret-key-change-in-production

# ─── Database ─────────────────────────────────────────────────
DB_PATH=./data/sample_ecommerce.db

# ─── Retrieval Settings ──────────────────────────────────────
TOP_K_TABLES=5
TOP_K_COLUMNS=15
MAX_RETRIES=3

# ─── Production deployment ───────────────────────────────────
# Set on the Node gateway service (Railway): internal URL of the FastAPI service.
# FASTAPI_URL=http://<fastapi-service-name>.railway.internal:8000

# Set on the frontend build (Vercel): public URL of the Node gateway, including /api.
# VITE_API_URL=https://<gateway-service-name>.up.railway.app/api
