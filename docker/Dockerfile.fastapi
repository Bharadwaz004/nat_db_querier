FROM python:3.11-slim

WORKDIR /app

COPY backend_fastapi/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend_fastapi/ ./backend_fastapi/
COPY data/ ./data_seed/

# Create sample DB in seed dir (copied to volume on first start)
RUN python data_seed/create_sample_db.py

EXPOSE 8000
ENV PYTHONPATH=/app

# On first start: copy seed data to volume mount if empty, then launch
CMD ["sh", "-c", "[ ! -f /app/data/sample_ecommerce.db ] && cp -r /app/data_seed/. /app/data/; uvicorn backend_fastapi.src.main:app --host 0.0.0.0 --port 8000"]
